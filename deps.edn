{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/core.async {:mvn/version "1.6.681"}}
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :repl {:extra-deps {org.clojure/tools.namespace {:mvn/version "1.3.0"}}}
  :simulate {:main-opts ["-m" "jmshelby.lot-o-odds.lucky-for-life.cli.simulate"]}
  :compare-games {:main-opts ["-m" "jmshelby.lot-o-odds.lucky-for-life.cli.compare-games"]}}}
